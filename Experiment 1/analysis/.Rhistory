facet_wrap(~ scenario) +
scale_color_manual(values = c("direct" = "#89B3F0", "negotiating" = "#FFBF39")) +
labs(
title = "Likelihood of Success by Ask Size, Choice, and Scenario",
x = "Ask Size",
y = "Likelihood of Success",
color = "Choice"
) +
theme_light()
