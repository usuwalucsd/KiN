) +
theme_light()
all_data <- all_data %>%
mutate(
ask_size = factor(ask_size, levels = c("small", "big")),
interaction_history = factor(interaction_history, levels = c("none", "failed"))
)
all_data %>%
pivot_longer(cols = c(direct_likelihood, negotiation_likelihood),
names_to = "likelihood_type",
values_to = "likelihood") %>%
mutate(likelihood_type = recode(likelihood_type,
"direct_likelihood" = "Direct",
"negotiation_likelihood" = "Negotiating")) %>%
group_by(scenario, ask_size, likelihood_type) %>%
summarise(
mean = mean(likelihood, na.rm = TRUE),
ci   = qt(0.975, df = n() - 1) * sd(likelihood, na.rm = TRUE) / sqrt(n()),
.groups = "drop"
) %>%
ggplot(aes(x = likelihood_type, y = mean, color = ask_size)) +
geom_point(size = 3, position = position_dodge(width = 0.5)) +
geom_errorbar(aes(ymin = mean - ci, ymax = mean + ci),
width = 0.15, position = position_dodge(width = 0.5)) +
facet_wrap(~ scenario) +
scale_color_manual(values = c("small" = "#EBAEC8", "big" = "#9FEB73")) +
labs(
title = "Direct vs. Negotiation Likelihood by Scenario and Ask Size",
x = "Likelihood Type", y = "Mean Likelihood", color = "Ask Size"
) +
theme_light()
