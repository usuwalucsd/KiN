View(all_data)
all_data %>%
mutate(request_type = if_else(negotiating_request == 0, "Direct", "Negotiating")) %>%
group_by(scenario, ask_size, interaction_history, request_type) %>%
summarise(
mean = mean(choice_likelihood, na.rm = TRUE),
ci   = qt(0.975, df = n() - 1) * sd(choice_likelihood, na.rm = TRUE) / sqrt(n()),
n    = n(),
.groups = "drop"
) %>%
ggplot(aes(x = ask_size, y = mean, fill = interaction_history)) +
geom_col(position = position_dodge(width = 0.9)) +
geom_errorbar(aes(ymin = mean - ci, ymax = mean + ci),
position = position_dodge(width = 0.9),
width = 0.2, alpha = 0.6) +
geom_text(aes(label = paste0("n=", n), y = 0.05),
position = position_dodge(width = 0.9),
vjust = 0, size = 3) +
facet_grid(request_type ~ scenario) +
scale_fill_manual(values = c("failed" = "#89B3F0", "none" = "#FFBF39")) +
labs(
title = "Perceived Likelihood of Success for Own Choice",
x = "Ask Size", y = "Mean Choice Likelihood", fill = "Interaction History"
) +
theme_light()
ggplot(all_data, aes(x = age_day_of, y = choice_likelihood, color = ask_size)) +
geom_jitter(size = 2, alpha = 0.5, height = 0.05) +
geom_smooth(method = "lm", se = TRUE, alpha = 0.2) +
facet_wrap(~ interaction_history) +
scale_color_manual(values = c("small" = "#EBAEC8", "big" = "#9FEB73")) +
labs(
title = "Choice Likelihood by Age, Ask Size and Interaction History",
x = "Age (days)", y = "Choice Likelihood", color = "Ask Size"
) +
theme_light()
all_data %>%
mutate(
request_type = if_else(negotiating_request == 0, "Direct", "Negotiating"),
likelihood_label = factor(choice_likelihood,
levels = c(0, 1, 2),
labels = c("Unlikely", "Neutral", "Likely"))
) %>%
count(request_type, likelihood_label) %>%
group_by(request_type) %>%
mutate(prop = n / sum(n)) %>%
ggplot(aes(x = request_type, y = prop, fill = likelihood_label)) +
geom_col(width = 0.5) +
geom_text(aes(label = paste0("n=", n)),
position = position_stack(vjust = 0.5),
size = 3.5, color = "white", fontface = "bold") +
scale_fill_manual(values = c("Unlikely" = "#E07B7B", "Neutral" = "#D4D4D4", "Likely" = "#89B3F0")) +
scale_y_continuous(labels = scales::percent) +
labs(
title = "Perceived Likelihood of Success for Own Choice",
x = "Request Type", y = "Proportion", fill = "Likelihood"
) +
theme_light()
