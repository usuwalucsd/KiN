```{r exclusion criteria}
warmup <- function(csv){
  data <- read.csv(csv) %>%
  mutate(participant_id = fromJSON(.$response[2])[[1]]) %>%
  filter(scenario == 'warmup')
  
  return (data)
}

exclusion <- list.files("./data", pattern = "*.csv", full.names = TRUE) %>%
