# just so that the condition orders make sense in the figure (small --> big; none --> failed)
all_data <- all_data %>%
  mutate(
    ask_size = factor(ask_size, levels = c("small", "big")),
    interaction_history = factor(interaction_history, levels = c("none", "failed"))
  )

# scenario x conditions 
summary_data <- all_data %>%
  group_by(scenario, ask_size, interaction_history) %>%
  summarise( prop_negotiating = mean(negotiating_request), .groups = "drop")

ggplot(summary_data, aes(x = ask_size,y = prop_negotiating, fill = interaction_history)) +
  geom_bar(stat = "identity", position = position_dodge()) +
  facet_wrap(~ scenario) +
  ylim(0,1) +
  labs(y = "Proportion Neogotiating", x = "Ask Size", fill = "Interaction History") +
  scale_fill_manual(values = c("failed" = "#89B3F0","none" = "#F0D87F"))+
  theme_light()

