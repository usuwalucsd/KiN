# remove everything from environment
rm(list = ls(all=TRUE))

# Load required packages
library(tidyverse)
library(zoo)
library(reshape2)
library(data.table)
library(dplyr)
library(glmmTMB)
library(ggplot2)


# Load SciApp data
# make list of all csv files (trial info)

load("~/Desktop/Analyses/Ricarda/SciApp3/eyetracking/alldata.RData")

d.child <- all.data.child
d.parent <- all.data.parent

d.child <- d.child %>%
  mutate(trial.change = trial.no != lag(trial.no))

d.child$target <- ifelse(d.child$target=="507", "504", d.child$target)
d.child$object <- ifelse(d.child$object=="507", "504", d.child$object)
d.child$trial.start <- ifelse(d.child$trial.change=="TRUE",d.child$gaze.time, NA)
d.child$trial.start[1] <- d.child$gaze.time[1]
d.child$trial.start <- na.locf(d.child$trial.start)
d.child$trial.time <- d.child$gaze.time-d.child$trial.start
d.child$bin <- ceiling((d.child$trial.time)/33)*33

d.child <- d.child %>%
  arrange(ID, block_number, phase, trial.no,bin) 
d.child <- d.child %>% distinct(ID, block_number, phase, trial.no, bin, .keep_all = TRUE)

d.child.learn <- subset(d.child, d.child$phase=="Learn")

d.parent <- d.parent %>%
  mutate(trial.change = trial.no != lag(trial.no))

d.parent$target <- ifelse(d.parent$target=="507", "504", d.parent$target)
d.parent$object <- ifelse(d.parent$object=="507", "504", d.parent$object)
d.parent$trial.start <- ifelse(d.parent$trial.change=="TRUE",d.parent$gaze.time, NA)
d.parent$trial.start[1] <- d.parent$gaze.time[1]
d.parent$trial.start <- na.locf(d.parent$trial.start)
d.parent$trial.time <- d.parent$gaze.time-d.parent$trial.start
d.parent$bin <- ceiling((d.parent$trial.time)/33)*33

d.parent <- d.parent %>%
  arrange(ID, block_number, phase, trial.no,bin) 
d.parent <- d.parent %>% distinct(ID, block_number, phase, trial.no, bin, .keep_all = TRUE)

d.parent.learn <- subset(d.parent, d.parent$phase=="Learn")

d.child.learn$role <- "child"
d.parent.learn$role <- "parent"

d.learn <- rbind(d.child.learn, d.parent.learn)

d.learn$aoi <- ifelse(d.learn$object==d.learn$target, 1,
                            ifelse(d.learn$object=="face", -1, 0))
d.learn <- subset(d.learn, d.learn$bin >1000 & d.learn$bin <=10000)

d.learn <- d.learn %>%
  group_by(ID, role, block_number,phase,trial.no,target) %>%
  mutate(first_value = first(isLabeled))

d.learn$target <- as.numeric(as.character(d.learn$target))
d.learn <- subset(d.learn, !is.na(d.learn$target))

label <- unique(d.learn[,c("ID","target","isLabeled")])

d.learn.aggr <- subset(d.learn, d.learn$block_number!=0) %>%
  group_by(ID, role, block_number, target, isLabeled) %>%
  summarise(
    num_1s = sum(aoi == 1, na.rm = TRUE),
    num_neg1s = sum(aoi == -1, na.rm = TRUE),
    num_0s = sum(aoi == 0, na.rm = TRUE),
    #.groups = "drop"
  )

d.learn.aggr$PLI <- d.learn.aggr$num_1s/(d.learn.aggr$num_1s + d.learn.aggr$num_neg1s+ d.learn.aggr$num_0s)

range(d.learn.aggr$PLI, na.rm=T) #need to transform because beta models cannot handle exact 0 or 1
d.learn.aggr$tr.PLI=(d.learn.aggr$PLI*(nrow(d.learn.aggr)-1)+0.5)/nrow(d.learn.aggr) #this moves observations closer to 0.5

# Models including random slopes on random effects did not converge, including when correlations were removed. 
# This is the first model that converged for full and null models 
full.cp=glmmTMB(tr.PLI~isLabeled*role+
                 (1|ID)+(1|target), 
               data=d.learn.aggr, family=beta_family,
               control=glmmTMBControl(optimizer=optim,optArgs=list(method="BFGS")))

summary(full.cp)$varcor

null.cp=glmmTMB(tr.PLI~1+isLabeled+role+
                 (1|ID)+(1|target), 
               data=d.learn.aggr, family=beta_family,
               control=glmmTMBControl(optimizer=optim,optArgs=list(method="BFGS")))

round(as.data.frame(anova(full.cp, null.cp, test="Chisq")), 3)


# Model does not converge with block number as random effect
full.noint.cp=glmmTMB(tr.PLI~isLabeled+role+
                  (1|ID)+(1|target), 
                data=d.learn.aggr, family=beta_family,
                control=glmmTMBControl(optimizer=optim,optArgs=list(method="BFGS")))

# Main result to be reported in the manuscript
tests=as.data.frame(drop1(full.noint.cp, test="Chisq"))

#TABLE
tab_model.noint.cp <-tab_model(full.noint.cp, show.stat=T, show.est = T, transform = NULL, show.se = T, 
                                show.p = T, digits = 3, dv.labels = "")


d.learn$role[d.learn$role=="parent"] <- "mother"

ggplot(subset(d.learn, d.learn$block_number>0),
       aes(bin, aoi, color=isLabeled, fill=isLabeled)) + 
  stat_summary(fun=mean, geom="line") +
  stat_summary(fun.data=mean_se, geom="ribbon", color=NA, alpha=0.5) +
  theme_classic() + theme(text=element_text(size=25)) + theme(legend.title=element_blank()) +
  facet_grid(~ role) +
  theme_classic() + theme(text=element_text(size=25)) +
  theme(legend.title = element_blank()) +
  scale_color_viridis_d(option = "C", begin = 0.2, end = 0.8, labels = c("no.label trials", "label trials")) +
  scale_fill_viridis_d(option = "C", begin = 0.2, end = 0.8, labels = c("no.label trials", "label trials")) +
  labs(y="Prop.looking at image", x="Bin (ms)")
  
ggsave("plot_et.pdf", width = 10, height = 6)
ggsave("plot_et.png", width = 10, height = 6, dpi = 300)

d.child.samp <- subset(d.child, d.child$phase=="Sampling")
d.child.samp$target <- as.numeric(as.character(d.child.samp$target))
d.child.samp <- subset(d.child.samp, !is.na(d.child.samp$target))

d.child.samp$object <- as.numeric(as.character((d.child.samp$object)))
d.child.samp <- subset(d.child.samp, !is.na(d.child.samp$object))

d.child.samp <- merge(d.child.samp, label, by.x=c("ID","target"),by.y=c("ID","target"), all.x=TRUE)
#summary(as.factor(d.child.samp$isLabeled.y))

d.samp.rt <- d.child.samp %>%
  group_by(ID, block_number,trial.no) %>%
  summarise(exp.rt = exp.rt[!is.na(exp.rt)][1],  # Extract non-NA value
            max.bin = max(bin, na.rm = TRUE),      # Compute maximum
            .groups = "drop")

d.child.samp <- d.child.samp %>%
  arrange(ID, block_number, phase, trial.no,bin) 
#d.child.samp <- d.child.samp %>% distinct(ID, block_number, phase, trial.no, bin, .keep_all = TRUE)

d.parent.samp <- subset(d.parent, d.parent$phase=="Sampling")
d.parent.samp$target <- as.numeric(as.character((d.parent.samp$target)))
d.parent.samp <- subset(d.parent.samp, !is.na(d.parent.samp$target))

d.parent.samp$object <- as.numeric(as.character((d.parent.samp$object)))
d.parent.samp <- subset(d.parent.samp, !is.na(d.parent.samp$object))

d.parent.samp <- merge(d.parent.samp, label, by.x=c("ID","target"),by.y=c("ID","target"), all.x=TRUE)
#summary(as.factor(d.parent.samp$isLabeled.y))

d.samp.rt.p <- d.parent.samp %>%
  group_by(ID, block_number,trial.no) %>%
  summarise(exp.rt = exp.rt[!is.na(exp.rt)][1],  # Extract non-NA value
            max.bin = max(bin, na.rm = TRUE),      # Compute maximum
            .groups = "drop")

d.samp.rt <- merge(d.samp.rt, d.samp.rt.p, by.x=c("ID","block_number","trial.no"), by.y=c("ID","block_number","trial.no"), all.x=T, all.y=T)

d.samp.rt <- d.samp.rt %>%
  mutate(rt = case_when(
    !is.na(exp.rt.x) & !is.na(exp.rt.y) & exp.rt.x == exp.rt.y ~ exp.rt.x,
    is.na(exp.rt.x) ~ exp.rt.y,
    is.na(exp.rt.y) ~ exp.rt.x,
    TRUE ~ NA_real_
  ))

d.samp.rt$rt <- ceiling((d.samp.rt$rt)/33)*33

d.samp.rt <- d.samp.rt[,c("ID","block_number","trial.no","rt")]

d.parent.samp <- d.parent.samp %>%
  arrange(ID, block_number, phase, trial.no,bin) 

#d.parent.samp <- d.parent.samp %>% distinct(ID, block_number, phase, trial.no, bin, .keep_all = TRUE)

d.child.samp$role <- "child"
d.parent.samp$role <- "parent"

d.samp <- rbind(d.child.samp, d.parent.samp)
d.samp <- merge(d.samp, d.samp.rt, by.x=c("ID","block_number","trial.no"), by.y=c("ID","block_number","trial.no"))

summary(as.factor(d.samp$object))
d.samp$aoi <- ifelse(d.samp$object==d.samp$target, 1,
                      ifelse(d.samp$object!=d.samp$target & d.samp$object!="face", -1, 0))

d.samp$face <- ifelse(d.samp$object=="face", 1, 0)
d.samp$rt.bin <- d.samp$bin - d.samp$rt
d.samp <- subset(d.samp, d.samp$rt.bin >0 & d.samp$rt.bin <=7500)

d.samp.aggr <- subset(d.samp, d.samp$block_number!=0) %>%
  group_by(ID, active_player, role, block_number, target, isLabeled.y) %>%
  summarise(
    num_1s = sum(aoi == 1, na.rm = TRUE),
    num_neg1s = sum(aoi == -1, na.rm = TRUE),
    num_0s = sum(aoi == 0, na.rm = TRUE),
    num_f1s = sum(face == 1, na.rm = TRUE),
    num_f0s = sum(face == 0, na.rm = TRUE),
    #.groups = "drop"
  )

d.samp.aggr$PLI <- d.samp.aggr$num_1s/(d.samp.aggr$num_1s + d.samp.aggr$num_neg1s+ d.samp.aggr$num_0s)

range(d.samp.aggr$PLI, na.rm=T) #need to transform because beta models cannot handle exact 0 or 1
d.samp.aggr$tr.PLI=(d.samp.aggr$PLI*(nrow(d.samp.aggr)-1)+0.5)/nrow(d.samp.aggr) #this moves observations closer to 0.5

d.samp.aggr <- d.samp.aggr %>% rename(isLabeled = isLabeled.y)
# Models including random slopes on random effects did not converge, including when correlations were removed. 
# This is the first model that converged for full and null models 

full.cp.samp=glmmTMB(tr.PLI~role*(isLabeled+active_player)+
                  (1|ID)+(1|target)+(1|block_number), 
                data=d.samp.aggr, family=beta_family,
                control=glmmTMBControl(optimizer=optim,optArgs=list(method="BFGS")))

summary(full.cp.samp)$varcor
tests.cp.samp=as.data.frame(drop1(full.cp.samp, test="Chisq"))
round(tests.cp.samp, 3)

# Model does not converge with block number
null.cp.samp=glmmTMB(tr.PLI~1+role+
                  (1|ID)+(1|target)+(1|block_number), 
                data=d.samp.aggr, family=beta_family,
                control=glmmTMBControl(optimizer=optim,optArgs=list(method="BFGS")))

round(as.data.frame(anova(full.cp.samp, null.cp.samp, test="Chisq")), 3)

ggplot(subset(d.samp,d.samp$block_number>0 & d.samp$rt.bin<7500),
       aes(rt.bin, aoi, color=active_player, fill=active_player)) + 
  stat_summary(fun=mean, geom="line") +
  stat_summary(fun.data=mean_se, geom="ribbon", color=NA, alpha=0.5) +
