## power analysis on sampling effect ##
# take out block and age since these were not significant
# look at difference between children's and mother's sampling choice
M1.power <- glmer(response ~ 1 + choice+ 
                        (1 | ID) + 
                        (1 | targetImage), 
                      data = d_samp, family = binomial(link = "logit")) 
round(summary(M1.power)$coefficients, 3)

#effect sizes
coefs <- fixef(M1.power)
coefs["choicepassive"] <- 0.5
coefs

# simulations
library(simr)
power_samp <- powerSim(M1.power, test = fixed("choice"), nsim= 1000)
summary(power_samp)
# Out of 1000 simulations, the effect was successfully detected in all 1000 meaning 100% power
# The 95% confidence (or credible) interval for this power estimate is between ~99.63% and 100%
